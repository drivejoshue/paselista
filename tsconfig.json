

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./resources/js/schoolcore/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "resources/js/schoolcore/**/*.ts",
    "resources/js/schoolcore/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "vendor"
  ]
}
